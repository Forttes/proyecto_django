      "name": "Inyección XSS",
      "description": "Inyectar JavaScript o etiquetas HTML para probar vulnerabilidades de XSS."
    },
    {
      "id": 9482974,
      "name": "Entrada fuzz",
      "description": "Enviar cargas útiles grandes o generadas aleatoriamente para probar validación de entrada y estabilidad."
    },
    {
      "id": 9482975,
      "name": "Inyección de comandos",
